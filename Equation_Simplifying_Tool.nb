Cell[CellGroupData[{

Cell["Overtone Mode", "Subsection",
 CellChangeTimes->{{3.797653966435385*^9, 
  3.797653980389075*^9}},ExpressionUUID->"2fafa3d0-0e48-4358-a06d-\
d2b4a3d2f162"],

Cell[TextData[{
 "Finally, C stars in the overtone mode. Using the relations for logR(logL, \
logM) and logP(logM,logR), determine functions for logM and log R.\nlogR = \
-0.323(27) + 0.737(7)logL - 0.371(14)logM ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["R", "2"], "=", "0.907"}], ")"}], TraditionalForm]],
  ExpressionUUID->"c84cae75-17b9-4e6b-9b46-2fbc5df3101f"],
 "\nlogP = -1.55431(1) - 0.528676(6)logM + 1.570255(6)logR ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["R", "2"], "=", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"f29f9cc3-b5a4-4369-8d12-c7810334cbe6"],
 "*"
}], "Text",
 CellChangeTimes->{{3.797710914292877*^9, 3.7977109258534*^9}, {
  3.79771106443182*^9, 3.7977110716623955`*^9}, {3.7977112200965853`*^9, 
  3.797711233515789*^9}},ExpressionUUID->"3c866395-46b4-4791-8cf8-\
10c79add0c93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"logR", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "0.323"}], "+", 
       RowBox[{"0.737", "logL"}], "-", 
       RowBox[{"0.371", "logM"}]}]}], ",", 
     RowBox[{"logP", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "1.554"}], "-", 
       RowBox[{"0.529", "logM"}], "+", 
       RowBox[{"1.570", "logR"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"logR", ",", "logM"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7977111149878807`*^9, 3.79771114213498*^9}, 
   3.797711250861581*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"605b7afd-8c1b-4bea-a5e2-0e40d4ca9c63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"logR", "\[Rule]", 
     RowBox[{"0.36498241068134984`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.3507724005146337`", " ", "logL"}], "+", 
      RowBox[{"0.33379218512420483`", " ", "logP"}]}]}], ",", 
    RowBox[{"logM", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "1.8544000287907003`"}], "+", 
      RowBox[{"1.041044742548157`", " ", "logL"}], "-", 
      RowBox[{"0.8997093938657812`", " ", "logP"}]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.797711143955449*^9, 3.797711269360424*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"7baab901-d1f5-4a0b-9c2f-e506ba7ff74b"]
}, Open  ]],

Cell["\<\
So now we have the relations
logR(logL, logP) = 0.365 + 0.351logL + 0.334logP
logM(logL,logP) = -1.854 + 1.041logL - 0.900logP\
\>", "Text",
