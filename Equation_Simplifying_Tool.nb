Cell[CellGroupData[{

Cell["Overtone Mode", "Subsection",
 CellChangeTimes->{{3.797653966435385*^9, 
  3.797653980389075*^9}},ExpressionUUID->"5fb721ef-b607-4035-9df4-\
bc3133a6133a"],

Cell["\<\
Using the functions logR(log L, log M) and logP(logM, logR), determine \
relations for logR and log P.\
\>", "Text",
 CellChangeTimes->{{3.7976535826626315`*^9, 3.7976537107105856`*^9}, 
   3.797710301323372*^9},ExpressionUUID->"74a72528-e764-47a1-9026-\
5511684532d1"],

Cell[TextData[{
 "Next, M stars in the overtone mode.\nlogR ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     RowBox[{"-", "0.115"}], "+", 
     RowBox[{"0.68", "logL"}], "+", 
     RowBox[{"0.088", 
      RowBox[{"log", "(", 
       RowBox[{"Z", "/", 
        SubscriptBox["Z", "\[Sun]"]}], ")"}]}], "-", 
     RowBox[{"0.52", "log\[Alpha]"}], "+", 
     RowBox[{"s", "(", 
      RowBox[{"0.0252", "-", 
       RowBox[{"0.31", "logM"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5027a522-546f-4c5b-9600-e1897f8bf556"],
 " (s=0 if M<1.175, 1 if M>1.175)\nlogP = -1.60 - 0.51logM + 1.59logR"
}], "Text",
 CellChangeTimes->{{3.797653722966732*^9, 3.7976537770789475`*^9}, {
   3.79765398495823*^9, 3.797653985846038*^9}, {3.7976540186588864`*^9, 
   3.797654021787732*^9}, {3.797654075817182*^9, 3.797654104708459*^9}, {
   3.797654864830518*^9, 3.7976548707999463`*^9}, {3.7976549160631123`*^9, 
   3.7976549242638435`*^9}, {3.7976550240275736`*^9, 
   3.7976550246111035`*^9}, {3.7977102105206785`*^9, 3.797710211240333*^9}, {
   3.797710306266876*^9, 3.7977103488165827`*^9}, 
   3.797719399043208*^9},ExpressionUUID->"1419adaf-ef55-45cc-9d76-\
1e7a9930f93f"],

Cell["For the case of M<1.175,", "Text",
 CellChangeTimes->{{3.7977194021009893`*^9, 
  3.7977194095627747`*^9}},ExpressionUUID->"cc49d453-f32e-4fd2-8385-\
de0572320ab0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"logR", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "0.115"}], "+", 
       RowBox[{"0.68", "logL"}], "+", 
       RowBox[{"0.088", "logZ"}], "-", 
       RowBox[{"0.52", "log\[Alpha]"}]}]}], ",", 
     RowBox[{"logP", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "1.60"}], "-", 
       RowBox[{"0.51", "logM"}], "+", 
       RowBox[{"1.59", "logR"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"logR", ",", "logM"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.797719411261319*^9, 3.7977195091915493`*^9}, 
   3.797719561854624*^9, 3.797720882443536*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"7a67d453-5877-4302-9747-4f4a3ff63016"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"logR", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "0.115`"}], "+", 
      RowBox[{"0.68`", " ", "logL"}], "+", 
      RowBox[{"0.088`", " ", "logZ"}], "-", 
      RowBox[{"0.52`", " ", "log\[Alpha]"}]}]}], ",", 
    RowBox[{"logM", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "3.49578431372549`"}], "+", 
      RowBox[{"2.12`", " ", "logL"}], "-", 
      RowBox[{"1.9607843137254901`", " ", "logP"}], "+", 
      RowBox[{"0.2743529411764706`", " ", "logZ"}], "-", 
      RowBox[{"1.6211764705882354`", " ", "log\[Alpha]"}]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.79772089531124*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"1f319b41-80c7-43e7-b99e-4ecc897c1549"]
}, Open  ]],

Cell["This tells us the relations for logR and logM are", "Text",
