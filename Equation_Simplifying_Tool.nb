   RowBox[{
    RowBox[{"logR", "\[Rule]", 
     RowBox[{"0.44890018945059335`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.34579718815435245`", " ", "logL"}], "+", 
      RowBox[{"0.30910359956127237`", " ", "logP"}], "+", 
