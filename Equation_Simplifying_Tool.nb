    RowBox[{"logR", ",", "logM"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.797719543922858*^9, 3.7977195475956535`*^9}, {
  3.7977205962899094`*^9, 3.7977206136831236`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"ec53da39-247b-41bc-8321-786f635dda09"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"logR", "\[Rule]", 
     RowBox[{"0.4053620082657278`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.3799173427215674`", " ", "logL"}], "+", 
      RowBox[{"0.23725700290831164`", " ", "logP"}], "+", 
      RowBox[{"0.049165773763967545`", " ", "logZ"}], "-", 
