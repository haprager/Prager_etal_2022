9d5449860ceb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"logR", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "0.115"}], "+", 
       RowBox[{"0.68", "logL"}], "+", 
       RowBox[{"0.088", "logZ"}], "-", 
       RowBox[{"0.52", "log\[Alpha]"}]}]}], ",", 
     RowBox[{"logP", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "1.92"}], "-", 
