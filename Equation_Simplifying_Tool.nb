Cell[CellGroupData[{

Cell["Fundamental Mode", "Subsection",
 CellChangeTimes->{{3.797653966435385*^9, 
  3.7976539690998077`*^9}},ExpressionUUID->"3ffb9aa6-693d-4bd4-9d2e-\
a8c09b0a60a4"],

Cell[TextData[{
 "First, M stars in the fundamental mode. Using the relations for logR(logL, \
logM) and logP(logM,logR), determine functions for logM and log R.\nlogR = \
-0.241(9) + 0.690(3)logL - 0.251(4)logM ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["R", "2"], "=", "0.990"}], ")"}], TraditionalForm]],
  ExpressionUUID->"4fc18149-5043-4b0c-b326-41a47eeb99a7"],
 "\nlogP = -2.234(5) - 0.780(2)logM + 2.027(2)logR ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["R", "2"], "=", "0.999"}], ")"}], TraditionalForm]],
  ExpressionUUID->"42c13245-6de0-4727-b307-5ef3300f8dab"]
}], "Text",
 CellChangeTimes->{{3.797653722966732*^9, 3.7976537770789475`*^9}, {
  3.7976547554740615`*^9, 3.797654758362688*^9}, {3.797654827762802*^9, 
  3.797654922142915*^9}, {3.797655011056776*^9, 3.797655011537214*^9}, {
  3.797710392741519*^9, 
  3.797710426282031*^9}},ExpressionUUID->"e5a32356-c9f5-43f6-8c42-\
dcb37c5221dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"logR", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "0.241"}], "+", 
       RowBox[{"0.690", "logL"}], "-", 
       RowBox[{"0.251", "logM"}]}]}], ",", 
     RowBox[{"logP", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "2.234"}], "-", 
       RowBox[{"0.780", "logM"}], "+", 
       RowBox[{"2.027", "logR"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"logR", ",", "logM"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7977104369407225`*^9, 3.797710488377513*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"fee2db81-7eda-4405-89ef-4e714479d42a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"logR", "\[Rule]", 
     RowBox[{"0.28923079788047107`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.41760521797021516`", " ", "logL"}], "+", 
      RowBox[{"0.1947582863443404`", " ", "logP"}]}]}], ",", 
    RowBox[{"logM", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "2.11247329832857`"}], "+", 
      RowBox[{"1.0852381754174694`", " ", "logL"}], "-", 
      RowBox[{"0.7759294276666948`", " ", "logP"}]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.797710488742871*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"3a7fc1e7-2220-4ee4-8f58-19dfd34fb996"]
}, Open  ]],

Cell["\<\
So now we have the relations
logR(logL, logP) = 0.289 + 0.417logL + 0.195logP
logM(logL,logP) = -2.112 + 1.085logL - 0.776logP\
\>", "Text",
 CellChangeTimes->{{3.797710527133794*^9, 
  3.797710603214983*^9}},ExpressionUUID->"a95010ac-08dc-4bd1-80f2-\
6a752e18f041"],

