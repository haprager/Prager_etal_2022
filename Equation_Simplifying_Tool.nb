83845ed651f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"logR", "\[Equal]", 
      RowBox[{
       RowBox[{"-", "0.115"}], "+", 
       RowBox[{"0.68", "logL"}], "+", 
       RowBox[{"0.088", "logZ"}], "-", 
