  3.797720545473689*^9}},ExpressionUUID->"74df1c5b-dc2d-4663-af45-\
dfd9fa160751"],

Cell["\<\
logR = 0.405 + 0.380logL + 0.237logP+0.049log(Z/Zsun)-0.291log(alpha)
