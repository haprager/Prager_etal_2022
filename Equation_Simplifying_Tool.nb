Cell[TextData[{
 "logR ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     RowBox[{"-", "0.115"}], "+", 
     RowBox[{"0.68", "logL"}], "+", 
     RowBox[{"0.088", 
      RowBox[{"log", "(", 
       RowBox[{"Z", "/", 
        SubscriptBox["Z", "\[Sun]"]}], ")"}]}], "-", 
     RowBox[{"0.52", "log\[Alpha]"}], "+", 
     RowBox[{"s", "(", 
      RowBox[{"0.0252", "-", 
       RowBox[{"0.31", "logM"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f878c22a-af12-42b8-b908-6bff76288337"],
 " (s=0 if M<1.175, 1 if M>1.175)\nlogP = -1.92 - 0.73logM +1.86logR"
}], "Text",
 CellChangeTimes->{{3.797653722966732*^9, 3.7976537770789475`*^9}, {
  3.7976547554740615`*^9, 3.797654758362688*^9}, {3.797654827762802*^9, 
