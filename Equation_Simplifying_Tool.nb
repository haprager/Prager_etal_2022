Cell[TextData[{
 "Assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"logMdot", "=", 
    RowBox[{
     SubscriptBox["a", "0"], "+", 
     RowBox[{
      SubscriptBox["a", "1"], "logM"}], "+", 
