  3.797710515932598*^9}},ExpressionUUID->"c050ddec-6699-4866-b92b-\
718bfa57a960"],

Cell[TextData[{
 "Assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"logMdot", "=", 
    RowBox[{
     SubscriptBox["a", "0"], "+", 
     RowBox[{
      SubscriptBox["a", "1"], "logM"}], "+", 
     RowBox[{
      SubscriptBox["a", "2"], "logL"}], "+", 
     RowBox[{
      SubscriptBox["a", "3"], "logR"}], "+", 
     RowBox[{
      SubscriptBox["a", "4"], "logP"}]}]}], TraditionalForm]],ExpressionUUID->
  "f91d2994-4db6-4a24-b908-cdeaff588746"],
 ". Use functions logP(logM,logR) and logR(logL, logM) to change this to the \
form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"logMdot", "=", 
    RowBox[{"a", "+", 
     RowBox[{"b", "*", "logL"}], "-", 
     RowBox[{"c", " ", "logM"}]}]}], TraditionalForm]],ExpressionUUID->
  "5dbfac44-38a2-4638-a399-ce50aec9c9fd"]
